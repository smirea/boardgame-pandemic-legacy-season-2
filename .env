# env-manager: boardgame-pandemic-legacy-season-2
# env-manager local: false
# env-manager generate: packages/shared/src/env.ts

UI_URL=http://boardgame-pandemic-legacy-season-2.localhost # {url}
SERVER_URL=http://127.0.0.1:6191 # {url}
UI_PORT=6190 # {int}
PORT=6191 # {int}
# Signaling Worker that introduces players to the host (apps/signal). Game traffic never goes through it.
SIGNAL_URL=http://127.0.0.1:8787 # {url}
# `bun run dev` runs its own signaling Worker on this port, and Vite passes `/signal` on the page's own origin to it, so a browser on another machine reaches it. Not 8787, which the playtest lab takes.
DEV_SIGNAL_PORT=6192 # {int}
# The passphrase players type to host or join under `bun run dev`.
DEV_SIGNAL_SECRET=pandemic # {string}
# `production` in env-manager prod. apps/server/src/config.ts requires production-only secrets.
APP_ENV=development # {string:format(/^(development|production)$/)}
# ProcrastiMate personal token (Settings › Personal token) the UI dev server adds when the feedback editor posts a task. An AI account's token cannot upload the image. Without it the Share menu has no ProcrastiMate entry.
PROCRASTIMATE_TOKEN= # {optional string}
# The passphrase players type to host or join on the deployed site, pandemic-legacy-s2.stf.lol. A secret on the production Worker, pushed by `bun run secrets:push`.
SIGNAL_SECRET= # {optional string}
# Deploys the production Worker. CI takes them from the repository secrets.
CLOUDFLARE_API_TOKEN= # {optional string}
CLOUDFLARE_ACCOUNT_ID= # {optional string}

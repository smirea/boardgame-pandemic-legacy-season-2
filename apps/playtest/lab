#!/usr/bin/env bun
/**
 * Runs the playtest lab. `start` launches the daemon in the background and waits until it answers.
 * Everything else is forwarded to the running daemon as the `lab` operator.
 */
import { closeSync, existsSync, mkdirSync, openSync, readdirSync, readFileSync, renameSync, rmSync, statSync } from 'node:fs';
import { join, resolve } from 'node:path';
import { loadConfig } from './src/config.ts';

const [verb, ...rest] = process.argv.slice(2);

if (verb === 'start') {
	const file = rest.find(arg => !arg.startsWith('--'));
	if (!file) throw new Error('usage: lab start <config.json> [--fresh] [--no-build]');
	const config = loadConfig(resolve(file));
	mkdirSync(config.runDir, { recursive: true });
	const pidFile = join(config.runDir, 'daemon.json');
	if (existsSync(pidFile)) {
		const { pid } = JSON.parse(readFileSync(pidFile, 'utf8')) as { pid: number };
		try {
			process.kill(pid, 0);
			throw new Error(`run ${config.run} is already live as pid ${pid}. Stop it with: lab stop`);
		} catch (error) {
			if ((error as NodeJS.ErrnoException).code !== 'ESRCH') throw error;
			rmSync(pidFile);
		}
	}
	if (rest.includes('--fresh') && existsSync(join(config.runDir, 'journal.jsonl'))) {
		// A fresh run keeps the old one beside it, so nothing a past run recorded is lost.
		renameSync(config.runDir, `${config.runDir}-${new Date().toISOString().replaceAll(/[:.]/g, '-')}`);
		mkdirSync(config.runDir, { recursive: true });
	}
	const logFile = join(config.runDir, 'daemon.log');
	const log = openSync(logFile, 'a');
	const child = Bun.spawn(['bun', join(import.meta.dir, 'src/daemon.ts'), config.file, ...rest.filter(arg => arg.startsWith('--'))], {
		cwd: import.meta.dir,
		stdio: ['ignore', log, log],
	});
	child.unref();
	closeSync(log);
	for (const deadline = Date.now() + 240_000; ; ) {
		if (existsSync(pidFile)) break;
		if (child.exitCode !== null || Date.now() > deadline) {
			console.error(readFileSync(logFile, 'utf8').split('\n').slice(-30).join('\n'));
			throw new Error('the lab did not start');
		}
		await Bun.sleep(300);
	}
	console.log(readFileSync(logFile, 'utf8').trim().split('\n').at(-1));
	process.exit(0);
}

if (verb === 'review') {
	// Serves a run's recordings and the replay page without starting a game, for looking back at a finished run.
	const file = rest.find(arg => !arg.startsWith('--'));
	if (!file) throw new Error('usage: lab review <config.json>');
	const config = loadConfig(resolve(file));
	const { servePages, replaysUrl } = await import('./src/replays.ts');
	const server = servePages(config.port);
	console.log(`Replays for ${config.run}: ${replaysUrl(server.port!, config.run)}\nCtrl+C to stop.`);
	await new Promise(() => {});
}

const alive = (pid: number) => {
	try {
		process.kill(pid, 0);
		return true;
	} catch {
		return false;
	}
};

if (verb === 'stop') {
	const runs = join(import.meta.dir, 'runs');
	const pids = (existsSync(runs) ? readdirSync(runs) : [])
		.map(run => join(runs, run, 'daemon.json'))
		.filter(file => existsSync(file))
		.map(file => (JSON.parse(readFileSync(file, 'utf8')) as { pid: number }).pid);
	Bun.spawnSync(['bun', join(import.meta.dir, 'play'), 'lab', 'stop'], { stdio: ['ignore', 'ignore', 'ignore'] });
	for (const pid of pids) {
		for (const deadline = Date.now() + 15_000; alive(pid) && Date.now() < deadline; ) await Bun.sleep(100);
		if (alive(pid)) process.kill(pid, 'SIGKILL');
	}
	for (const run of existsSync(runs) ? readdirSync(runs) : []) rmSync(join(runs, run, 'daemon.json'), { force: true });
	console.log(pids.length ? 'Stopped.' : 'Nothing was running.');
	process.exit(0);
}

if (verb === 'watch') {
	// Blocks until something an operator would act on: the session ends, a player or the lab reports a problem, play stalls, or the lab dies.
	const numbers = rest.filter(arg => !arg.startsWith('--')).map(Number);
	const seconds = numbers[0] || 540;
	const stallAfter = numbers[1] || 600;
	const runs = join(import.meta.dir, 'runs');
	const live = (existsSync(runs) ? readdirSync(runs) : []).map(run => join(runs, run)).find(dir => existsSync(join(dir, 'daemon.json')));
	if (!live) {
		console.log('EVENT lab-down: nothing is running');
		process.exit(0);
	}
	const journal = join(live, 'journal.jsonl');
	let offset = existsSync(journal) ? statSync(journal).size : 0;
	const session = () => Bun.spawnSync(['bun', join(import.meta.dir, 'play'), 'lab', 'session'], { stdio: ['ignore', 'pipe', 'ignore'] });
	for (const deadline = Date.now() + seconds * 1000; ; ) {
		const answer = session();
		const text = answer.stdout.toString().trim();
		if (answer.exitCode !== 0) {
			console.log('EVENT lab-down: the lab is not answering');
			break;
		}
		if (text.includes('"done":true')) {
			console.log(`EVENT session-complete: ${text}`);
			break;
		}
		const size = statSync(journal).size;
		const fresh = readFileSync(journal).subarray(offset).toString('utf8').split('\n').filter(Boolean);
		offset = size;
		const kinds = rest.includes('--quiet') ? 'tab-error|lab-error|tab-reload' : 'issue|tab-error|lab-error|no-change|tab-rejected|tab-reload';
		const alarms = fresh.filter(line => new RegExp(`"kind":"(${kinds})"`).test(line));
		if (alarms.length) {
			for (const line of alarms) console.log(`EVENT ${line.slice(0, 600)}`);
			break;
		}
		const idle = Math.round((Date.now() - statSync(journal).mtimeMs) / 1000);
		if (idle > stallAfter) {
			console.log(`EVENT stall: no command or chat for ${idle} seconds. ${text}`);
			break;
		}
		if (Date.now() > deadline) {
			console.log(`still playing: ${text}`);
			break;
		}
		await Bun.sleep(5000);
	}
	process.exit(0);
}

const proc = Bun.spawnSync(['bun', join(import.meta.dir, 'play'), 'lab', ...(verb ? [verb, ...rest] : ['help'])], {
	stdio: ['ignore', 'inherit', 'inherit'],
	env: process.env,
});
process.exit(proc.exitCode ?? 1);

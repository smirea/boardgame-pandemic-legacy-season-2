{
	"name": "@repo/ui",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "bun --env-file=../../.env --env-file=../../.env.local --bun vite build",
		"check": "bun --env-file=../../.env --env-file=../../.env.local svelte-kit sync && bun --env-file=../../.env --env-file=../../.env.local svelte-check-native --tsconfig ./tsconfig.json",
		"dev": "bun --env-file=../../.env --env-file=../../.env.local --bun vite",
		"preview": "bun --env-file=../../.env --env-file=../../.env.local --bun vite preview"
	},
	"dependencies": {
		"@fontsource/barlow-semi-condensed": "^5.3.0",
		"@fontsource/im-fell-english": "^5.3.0",
		"@repo/game": "workspace:*",
		"@repo/net": "workspace:*",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tanstack/svelte-query": "^6.3.2",
		"@threlte/core": "^8.7.0",
		"@threlte/extras": "^9.23.1",
		"d3-geo": "^3.1.2",
		"es-toolkit": "^1.52.0",
		"modern-screenshot": "^4.7.0",
		"svelte": "^5.57.2",
		"three": "^0.187.0",
		"topojson-client": "^3.1.0",
		"vite": "^8.3.4",
		"world-atlas": "^2.0.2"
	},
	"devDependencies": {
		"@google/genai": "^3.6.1",
		"@stefan.inc/feedback-engine": "^1.11.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3-geo": "^3.1.1",
		"@types/three": "^0.187.0",
		"@types/topojson-client": "^3.1.5",
		"@types/topojson-specification": "^1.0.5",
		"svelte-check-native": "^1.12.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3"
	}
}
